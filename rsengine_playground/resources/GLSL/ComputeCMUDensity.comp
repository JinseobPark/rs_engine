
#version 460

/*
 * CMU Density Computation (Brute Force O(N²))
 * 
 * Design Philosophy:
 * - Maintains simplicity and accuracy over spatial optimization
 * - For spatial acceleration, use ComputeGridSPH.comp instead
 * - Optimized for: small-to-medium particle counts (<50k)
 * - Focuses on: memory coalescing, early exits, constant pre-calculation
 */

layout (local_size_x = 256) in;

#define PI_FLOAT 3.1415927410125732421875f
layout (std430, binding = 0) buffer PositionBuffer {
    vec4 positions[]; // position xyz, density w
};

layout (std430, binding = 1) buffer VelocityBuffer {
    vec4 velocities[]; // velocity xyz, pressure w
};

uniform float particle_radius;
uniform float smoothing_length = 1.0f;
uniform float particle_mass = 1.0f;
uniform float u_density_0 = 1000.0f;
uniform float u_gas_constant = 2000.0f; // Gas constant for equation of state

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint num_particles = positions.length();
    
    if(id >= num_particles) {
        return;
    }

    // Cache current particle position to avoid repeated buffer reads
    vec3 pos_i = positions[id].xyz;
    
    // Pre-calculate constants
    float h = smoothing_length;
    float h_sq = h * h;
    float h_9 = h_sq * h_sq * h_sq * h_sq * h; // h^9
    
    // Poly6 kernel constant: 315 / (64 * PI * h^9)
    float poly6_constant = 315.0f / (64.0f * PI_FLOAT * h_9);
    float kernel_coefficient = particle_mass * poly6_constant;
    
    float density_sum = 0.0f;

    // Brute-force O(N²) loop: Check all particle pairs
    // Note: For large N, consider using Static Grid solver with spatial hashing
    for (uint j = 0; j < num_particles; ++j) {
        // Load neighbor position once (memory coalescing optimization)
        vec3 pos_j = positions[j].xyz;
        vec3 delta = pos_i - pos_j;
        float r_sq = dot(delta, delta); // r^2 (avoid sqrt for performance)
        
        // Early exit: Skip particles outside influence radius (most common case)
        if (r_sq >= h_sq) continue;
        
        // Poly6 kernel: (h^2 - r^2)^3
        float h_sq_minus_r_sq = h_sq - r_sq;
        float kernel_value = h_sq_minus_r_sq * h_sq_minus_r_sq * h_sq_minus_r_sq;
        density_sum += kernel_coefficient * kernel_value;
    }

    // Clamp density and compute pressure
    density_sum = min(density_sum, 5000.0f);
    float pressure = max(u_gas_constant * (density_sum - u_density_0), 0.0f);

    // Write results
    positions[id].w = density_sum;
    velocities[id].w = pressure;
}
