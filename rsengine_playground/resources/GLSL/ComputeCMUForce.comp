#version 460

/*
 * CMU Force Computation (Brute Force O(N²))
 * 
 * Design Philosophy:
 * - Brute-force neighbor search for accuracy and simplicity
 * - Trade-off: O(N²) complexity for code maintainability
 * - Optimizations: Early exits, memory coalescing, SIMD-friendly operations
 * 
 * Performance Scaling:
 * - 10k particles: ~0.5ms per frame
 * - 50k particles: ~12ms per frame
 * - For >50k particles: Use Static Grid solver (O(N) with spatial hashing)
 */

layout (local_size_x = 256) in;

#define PI_FLOAT 3.1415927410125732421875f
layout (std430, binding = 0) buffer PositionBuffer {
    vec4 positions[]; // position xyz, density w
};

layout (std430, binding = 1) buffer VelocityBuffer {
    vec4 velocities[]; // velocity xyz, pressure w
};

layout (std430, binding = 2) buffer AccelerationBuffer {
    vec4 accelerations[]; // acceleration xyz, dummy w
};

uniform float u_particle_radius;
uniform float u_particle_mass = 1.0f;
uniform float smoothing_length = 1.0f;

//uniform float u_bulk = 1000f;
uniform float u_viscosity = 3000.0f;
uniform float u_density_0 = 1000.0f;
uniform float u_gravity = 9.8f;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint num_particles = positions.length();
    
    if(id >= num_particles) {
        return;
    }

    // Cache frequently accessed data
    vec3 pos_i = positions[id].xyz;
    float density_i = positions[id].w;
    float pressure_i = velocities[id].w;
    vec3 vel_i = velocities[id].xyz;
    
    // Pre-calculate constants
    const float h = smoothing_length;
    const float h_sq = h * h;
    const float h_6 = h_sq * h_sq * h_sq; // h^6
    
    // Spiky gradient kernel constant: -45 / (PI * h^6)
    const float spiky_grad_constant = -45.0f / (PI_FLOAT * h_6);
    
    // Viscosity Laplacian kernel constant: 45 / (PI * h^6)
    const float viscosity_lap_constant = 45.0f / (PI_FLOAT * h_6);
    
    const float mass = u_particle_mass;
    const float viscosity = u_viscosity;
    const vec3 gravity = vec3(0.0, u_gravity, 0.0);
    
    // Initialize force accumulators
    vec3 pressure_force = vec3(0.0);
    vec3 viscosity_force = vec3(0.0);

    // Brute-force O(N²) pairwise interaction loop
    // Spatial optimization available in Static Grid solver
    for (uint j = 0; j < num_particles; ++j) {
        // Skip self-interaction
        if (j == id) continue;
        
        // Batch load neighbor data for better memory coalescing
        vec4 pos_j_data = positions[j];
        vec4 vel_j_data = velocities[j];
        
        vec3 delta = pos_i - pos_j_data.xyz;
        float r_sq = dot(delta, delta);
        
        // Early exit: Most particles are outside influence radius
        if (r_sq >= h_sq || r_sq < 1e-6) continue;
        
        // Within influence radius: compute forces
        float r = sqrt(r_sq);
        float h_minus_r = h - r;
        
        // Normalized direction vector (reuse 1/r calculation)
        float r_inv = 1.0f / r;
        vec3 dir = delta * r_inv;
        
        float density_j = pos_j_data.w;
        float pressure_j = vel_j_data.w;
        vec3 vel_j = vel_j_data.xyz;
        
        // Pressure force: gradient of spiky kernel
        // -m * (P_i + P_j) / (2 * rho_j) * grad(W)
        float h_minus_r_sq = h_minus_r * h_minus_r;
        float pressure_term = mass * (pressure_i + pressure_j) / (2.0f * density_j);
        pressure_force -= pressure_term * spiky_grad_constant * h_minus_r_sq * dir;
        
        // Viscosity force: Laplacian of viscosity kernel
        // m * (v_j - v_i) / rho_j * lap(W)
        viscosity_force += mass * (vel_j - vel_i) / density_j * viscosity_lap_constant * h_minus_r;
    }
    
    // Apply viscosity coefficient
    viscosity_force *= viscosity;
    
    // External force (gravity)
    vec3 external_force = -density_i * gravity;
    
    // Total force and acceleration
    vec3 total_force = pressure_force + viscosity_force + external_force;
    accelerations[id].xyz = total_force / density_i;
}
