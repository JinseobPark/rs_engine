{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RSEngine Debug (x64)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "rsengine_playground/SPH_MINT.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/t:RSEngine",
                "/m"
            ],
            "options": {
                "cwd": "${workspaceFolder:Root}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d", "/c",
                        "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\"", "&&"
                    ]
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build",
            "detail": "Build RSEngine static library (Debug x64)"
        },
